PORT=5000
MONGO_URI=mongodb://localhost:27017/gameon
JWT_SECRET=your_jwt_secret_here

# ─── Email / OTP (required for registration on production) ───────────────────
# Set EMAIL_SERVICE=gmail to enable real email sending via Nodemailer.
# If not set, the backend runs in dev-mode and returns the OTP in the API response.
EMAIL_SERVICE=gmail
EMAIL_USER=your_gmail_address@gmail.com
# Use a Gmail App Password, NOT your regular Gmail password.
# Generate one at: https://myaccount.google.com/apppasswords
# (Requires 2-Step Verification to be enabled on the Google account)
EMAIL_PASSWORD=your_gmail_app_password_here

# ─── CORS ────────────────────────────────────────────────────────────────────
CORS_ORIGIN=https://gameon24.netlify.app,http://localhost:5173

# ─── Session ─────────────────────────────────────────────────────────────────
SESSION_SECRET=your_session_secret_here
